<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>SimpleSchedulingExample</RootNamespace>
    <AssemblyName>SimpleSchedulingExample</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
    <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Platforms>x86;AnyCPU</Platforms>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DefaultItemExcludes>obj*/**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <AppDesigner Include="Properties\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DevExpress.Data" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Data.Desktop" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Mvvm" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Scheduler.Core" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Scheduler.CoreDesktop" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Wpf.Core" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Wpf.LayoutControl" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Wpf.Ribbon" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Wpf.Scheduling" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Wpf.Themes.Office2016Colorful" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Wpf.Themes.Office2016White" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Wpf.Themes.All" Version="26.1.*-*" />
  </ItemGroup>
</Project>
